# Copy to .env and fill in. .env is git-ignored. Never paste these values into chat or commit them.
# Only Phase 1 (orchestrator + LLM gateway) reads this file. The Phase 2 sandbox never sees it.

# --- LLM provider (needed from P2) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Set a credit limit on this key in the OpenRouter dashboard.

# --- Tracker / docs / SCM (needed from P4) ---
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=                # optional; default: JIRA_BASE_URL + /wiki (only with project.docs: confluence)
CONFLUENCE_API_TOKEN=               # optional; default: JIRA_API_TOKEN
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_TOKEN=
# or, if GitHub is chosen:
GITHUB_TOKEN=

# --- LLM models (optional; blank = config/org.yaml defaults) ---
# Canonical ids (claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5, claude-fable-5-1, …) are mapped to
# OpenRouter ids by the gateway (claude-x-5-5 → anthropic/claude-x-5.5). A provider id with a slash
# (e.g. anthropic/claude-sonnet-5.5) is passed through unchanged.
# Precedence: org.yaml < .env < the repo's .sdlc/pipeline.yaml < `--model stage=…` on the command line.
# Runs freeze their config at start, so a change here applies to new runs, not resumed ones.
SDLC_MODEL_DEFAULT=                 # every stage below, unless that stage is set
SDLC_MODEL_GRILL=                   # A1 grill            (org default: claude-sonnet-5-5)
SDLC_MODEL_PROPOSE=                 # A2 PRD + OpenSpec   (org default: claude-sonnet-5-5)
SDLC_MODEL_IMPLEMENT=               # B3 implement        (org default: claude-sonnet-5-5)
SDLC_MODEL_REVIEW=                  # B5 AI review        (org default: claude-opus-5-5; keep it different from implement)
SDLC_MODEL_RESOLVE_COMMENTS=        # B8 /sdlc fix        (org default: claude-sonnet-5-5)
SDLC_MODEL_REVIEW_FOLLOWUP=         # B5 review rounds 2+ (org default: claude-sonnet-5-5)
# Models named above are added to the allow-list automatically. To replace the whole list:
SDLC_ALLOWED_MODELS=                # comma-separated, e.g. claude-sonnet-5-5,claude-opus-5-5
# Extra canonical → provider id mappings for the gateway (JSON). Restart it after changing: docker compose up -d
SDLC_MODEL_MAP_JSON=                # e.g. {"my-review-model":"anthropic/claude-opus-5.5"}

# --- Images (optional): local builds instead of the published GHCR images (pipeline development) ---
SDLC_WORKER_IMAGE=                  # e.g. sdlc-worker:dev   (docker build -f worker/Dockerfile -t sdlc-worker:dev .)
SDLC_GATEWAY_IMAGE=                 # e.g. sdlc-gateway:dev  (docker compose build)

# --- Tests (P8): model for `sdlc eval` (red-team + skill evals) and the P2 spike's small calls ---
SDLC_TEST_MODEL=claude-haiku-5-5

# --- Optional: send per-stage trace spans to an OpenTelemetry collector (P7) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
